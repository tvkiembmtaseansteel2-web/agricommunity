# ===== Cấu hình môi trường AgriCommunity =====
# Bước 1: Sao chép file này thành ".env"
# Bước 2: Điền các giá trị thật bên dưới
# Lưu ý: KHÔNG commit file .env lên git (đã có trong .gitignore)

# --- Supabase (https://supabase.com) ---
# URL dự án và Anon Key: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Google Gemini API (https://aistudio.google.com/apikey) ---
# Nếu để trống, ứng dụng tự chạy "chế độ ngoại tuyến" với dữ liệu mẫu (Mock)
VITE_GEMINI_API_KEY=

# --- (Tùy chọn) Model Gemini dùng cho Bác sĩ cây trồng AI ---
# Mặc định gemini-3.1-flash-lite (rẻ, nhanh, hỗ trợ ảnh — đang khả dụng)
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# --- (Tùy chọn) Analytics ẩn danh (Plausible — tôn trọng Nghị định 13, không cookie) ---
# Để TRỐNG = tắt analytics. Để bật: tạo tài khoản plausible.io, điền domain của bạn
# Ví dụ: VITE_ANALYTICS_DOMAIN=agri.example.com
VITE_ANALYTICS_DOMAIN=

# =====================================================================
# ⚠️ Crawler KB (PRD Mục 3) — KHÔNG đặt vào .env frontend!
# Đây là secrets SERVER-SIDE dùng cho Supabase Edge Function.
# Cách đặt: supabase secrets set TÊN=giá-trị (xem supabase/README-crawler.md)
# =====================================================================
# SUPABASE_URL=            # URL project (Supabase)
# SUPABASE_SERVICE_ROLE_KEY=  # service_role key — chỉ server, không vào app
